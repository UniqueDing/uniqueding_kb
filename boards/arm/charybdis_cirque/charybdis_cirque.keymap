#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include <behaviors/mouse_keys.dtsi>
#include <behaviors/mouse_move.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>


#define DEF 0
#define QWE 1
#define SYM 2
#define NUM 3
#define NAV 4
#define FN  5
#define MSE 6
#define SCR 7

#define AS(keycode) &as LS(keycode) keycode

&mmv_input_listener {
  input-processors = <&zip_temp_layer MSE 1000>;
};

/ {
  mouse_listener {
    input-processors = <&zip_xy_scaler 3 2>;

    scroller {
      layers = <SCR>;
      input-processors = <&zip_xy_to_scroll_mapper>;
    };
  };

  behaviors {
    ltm: layer_tap_mouse {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&mkp>;
      display-name = "Layer-Tap";
    };
  }

  keymap {
    compatible = "zmk,keymap";
    default_layer {
      label = "DEF";
      bindings = <
&kp GRAVE     &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8    &kp N9   &kp N0    &kp BSPC
&lt NAV TAB   &kp Q    &kp W    &kp F    &kp P    &kp G        &kp J    &kp L    &kp U     &kp Y    &kp SEMI  &kp BSLH
&mt LCTRL ESC &kp A    &kp R    &kp S    &kp T    &kp D        &kp H    &kp N    &kp E     &kp I    &kp O     &lt SYM SQT
&kp LSHIFT    &kp Z    &kp X    &kp C    &kp V    &kp B        &kp K    &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp RSHIFT
                &kp LBKT   &kp RBKT   &kp SPACE  &kp LALT            &kp ENTER  &kp MINUS  &kp EQUAL
                &kp LC(LSHIFT) &kp LCTRL &kp LGUI &mo MSE            &lt NUM BSPC &lt FN DEL &kp ESC
      >;
    };

    qwerty_layer {
      label = "QWE";
      bindings = <
&kp GRAVE  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8    &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I     &kp O    &kp P     &kp BSLH
&kp CAPS   &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K     &kp L    &kp SEMI  &kp SQT
&kp LSHIFT &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp RSHIFT
                &kp LBKT   &kp RBKT   &kp SPACE  &kp LALT            &kp ENTER  &kp MINUS  &kp EQUAL
                &kp LC(LSHIFT) &kp LCTRL &kp LGUI &mo MSE            &lt NUM BSPC &lt FN DEL &kp ESC
      >;
    };

    symbol_layer {
      label = "SYM";
      bindings = <
&none      &none    &none    &none    &none    &none         &none    &none    &none    &none    &none    &none
&kp TAB    &kp EXCL &kp AT   &kp POUND &kp DLLR  &kp PRCNT   &none    &none    &none    &none    &none    &none
&kp BSPC   &kp LBKT &kp RBKT &kp LBRC  &kp RBRC  &kp PIPE    &none    &kp LPAR &kp RPAR &none    &none    &none
&kp LSHIFT &kp BSLH &kp AMPS &kp GRAVE &kp TILDE &kp CARET   &none    &none    &none    &none    &none    &kp RSHIFT
                    &none   &none   &trans  &trans           &trans  &none  &none
                    &trans  &trans  &trans  &trans           &trans  &trans &trans
      >;
    };

    num_layer {
      label = "NUM";
      bindings = <
&none      &none    &none    &none    &none    &none        &none    &none    &none     &none    &none     &none
&kp TAB    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &none    &none    &none     &none    &none     &none
&kp BSPC   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0       &none    &kp EQUAL &kp MINUS &kp PLUS &kp STAR &kp FSLH
&kp LSHIFT &none    &kp X    &kp UNDER &kp DOT &none        &none    &none    &none     &none    &none     &kp RSHIFT
                    &none   &none   &trans  &trans          &trans  &none  &none
                    &trans  &trans  &trans  &trans          &trans  &trans &trans
      >;
    };

    nav_layer {
      label = "NAV";
      bindings = <
&none      &none    &none    &none    &none    &none        &none    &none    &none     &none    &none     &none
&kp TAB    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5       &kp HOME &kp PG_DN &kp PG_UP &kp END  &none    &none
&kp CAPS   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT  &none  &none
&kp LSHIFT &kp F11  &kp F12  &kp F13  &kp F14  &kp DEL      &none    &none    &none     &none    &none     &kp RSHIFT
                    &none   &none   &trans  &trans          &trans  &none  &none
                    &trans  &trans  &trans  &trans          &trans  &trans &trans
      >;
    };

    fn_layer {
      label = "FN";
      bindings = <
&none    &none    &none   &none   &none   &none         &none   &none   &none   &none   &none   &none
&none    &none    &none   &none   &none   &none         &to QWE &to DEF &none   &none   &none   &none
&none    &none    &none   &none   &none   &none         &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
&none    &none    &none   &none   &none   &none         &out OUT_BLE &out OUT_USB &none &none &none &none
                  &none   &none   &none   &none                 &none   &none   &none
                  &none   &none   &none   &none                 &none   &none   &none
      >;
    };

    mouse_layer {
      label = "MSE";
      bindings = <
&none    &none    &none   &none   &none   &none        &none   &none    &none    &none    &none    &none
&none    &none    &none   &none   &none   &none        &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_RIGHT    &none  &none
&none    &none    &none   &none   &none   &none        &none   &mkp LCLK &ltm SCR MCLK &mkp RCLK   &none  &none
&none    &none    &none   &none   &none   &none        &none   &mkp MB4  &mkp MB5 &none    &none    &none
                  &none   &none   &none   &none                &none    &none   &none
                  &none   &none   &none   &none                &none    &none    &none
      >;
    };

    scroll_layer {
      label = "SCR";
      bindings = <
&none    &none    &none   &none   &none   &none        &none   &none    &none    &none    &none    &none
&none    &none    &none   &none   &none   &none        &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_RIGHT    &none  &none
&none    &none    &none   &none   &none   &none        &none   &mkp LCLK &ltm SCR MCLK &mkp RCLK   &none  &none
&none    &none    &none   &none   &none   &none        &none   &mkp MB4  &mkp MB5 &none    &none    &none
                  &none   &none   &none   &none                &none    &none   &none
                  &none   &none   &none   &none                &none    &none    &none
      >;
    };
   };
};
